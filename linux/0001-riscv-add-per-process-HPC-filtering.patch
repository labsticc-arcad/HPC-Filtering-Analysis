diff --git a/kernel/hpc/hpc_filtering.c b/kernel/hpc/hpc_filtering.c
new file mode 100644
index 000000000..08251a280
--- /dev/null
+++ b/kernel/hpc/hpc_filtering.c
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2025 Adam Henault <contact@adamhlt.com>
+ * Copyright (C) 2025 Lab-STICC
+ */
+
+#include <linux/debugfs.h>
+#include <linux/kfifo.h>
+#include <linux/spinlock.h>
+#include <linux/uaccess.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/fs.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+
+#include "hpc_filtering.h"
+
+/*
+ * Single-core, single-PID model: on each context switch, the counter delta
+ * since the previous switch is attributed to the outgoing task. Deltas are
+ * accumulated globally and, if prev is the filtered PID, per PID.
+ * Samples are logged to /sys/kernel/debug/hpc_monitor/log.
+ */
+
+#define HPC_LOG_FIFO_SIZE   (256 * 1024)
+#define HPC_LOG_LINE_MAX    1024
+
+static struct dentry *hpc_dbg_dir;
+static struct dentry *hpc_dbg_file;
+
+static DECLARE_KFIFO(hpc_log_fifo, char, HPC_LOG_FIFO_SIZE);
+static DEFINE_SPINLOCK(hpc_log_lock);
+
+static size_t hpc_log_push(const char *src, size_t len)
+{
+    unsigned long flags;
+    size_t pushed;
+
+    if (!len)
+        return 0;
+
+    if (len > HPC_LOG_LINE_MAX)
+        len = HPC_LOG_LINE_MAX;
+
+    spin_lock_irqsave(&hpc_log_lock, flags);
+    pushed = kfifo_in(&hpc_log_fifo, src, len);
+    spin_unlock_irqrestore(&hpc_log_lock, flags);
+
+    return pushed;
+}
+
+static ssize_t hpc_log_read(struct file *file, char __user *buf,
+                            size_t len, loff_t *ppos)
+{
+    unsigned long flags;
+    int ret;
+    unsigned int copied = 0;
+    unsigned int ulen;
+
+    if (len == 0)
+        return 0;
+
+    ulen = (unsigned int)len;
+
+    /* Pipe-like: consume what is in the FIFO */
+    spin_lock_irqsave(&hpc_log_lock, flags);
+    ret = kfifo_to_user(&hpc_log_fifo, buf, ulen, &copied);
+    spin_unlock_irqrestore(&hpc_log_lock, flags);
+
+    if (ret)
+        return ret;
+
+    if (copied == 0)
+        return 0;
+
+    *ppos += copied;
+
+    return copied;
+}
+
+static const struct file_operations hpc_log_fops = {
+    .owner = THIS_MODULE,
+    .read  = hpc_log_read,
+    .llseek = no_llseek,
+};
+
+static void hpc_log_debugfs_init(void)
+{
+    INIT_KFIFO(hpc_log_fifo);
+
+    hpc_dbg_dir = debugfs_create_dir("hpc_monitor", NULL);
+    if (IS_ERR_OR_NULL(hpc_dbg_dir)) {
+        pr_warn("hpc: debugfs dir creation failed\n");
+        hpc_dbg_dir = NULL;
+        return;
+    }
+
+    hpc_dbg_file = debugfs_create_file("log", 0444, hpc_dbg_dir, NULL, &hpc_log_fops);
+    if (IS_ERR_OR_NULL(hpc_dbg_file)) {
+        pr_warn("hpc: debugfs file creation failed\n");
+        hpc_dbg_file = NULL;
+    }
+}
+
+static void hpc_log_debugfs_exit(void)
+{
+    if (hpc_dbg_file)
+        debugfs_remove(hpc_dbg_file);
+    if (hpc_dbg_dir)
+        debugfs_remove(hpc_dbg_dir);
+    hpc_dbg_file = NULL;
+    hpc_dbg_dir = NULL;
+}
+
+static int hpc_toogle_filtering = 0;
+static int pid_filter = -1;                 /* -1 = none */
+
+static unsigned long last_snapshot[HPC_NUM];
+static int last_valid = 0;
+
+static unsigned long accum_pid[HPC_NUM];
+static unsigned long accum_global[HPC_NUM];
+
+int toogle_filtering(void)
+{
+    hpc_toogle_filtering = !hpc_toogle_filtering;
+
+    memset(accum_pid, 0, sizeof(accum_pid));
+    memset(accum_global, 0, sizeof(accum_global));
+    memset(last_snapshot, 0, sizeof(last_snapshot));
+    last_valid = 0;
+
+    {
+        char msg[64];
+        int l = scnprintf(msg, sizeof(msg), "FILTERING %s\n",
+                          hpc_toogle_filtering ? "ON" : "OFF");
+        if (hpc_log_push(msg, l) != l)
+            pr_info_ratelimited("hpc: log fifo full (state)\n");
+    }
+
+    return hpc_toogle_filtering;
+}
+
+void set_pid_filter(int pid)
+{
+    memset(accum_pid, 0, sizeof(accum_pid));
+    pid_filter = pid;
+
+    {
+        char msg[64];
+        int l = scnprintf(msg, sizeof(msg), "SET PID FILTER %d\n", pid);
+        if (hpc_log_push(msg, l) != l)
+            pr_info_ratelimited("hpc: log fifo full (set pid)\n");
+    }
+}
+
+void hpc_account_switch(struct task_struct *prev)
+{
+    unsigned long now[HPC_NUM];
+    unsigned long delta[HPC_NUM];
+    int i;
+
+    if (!hpc_toogle_filtering)
+        return;
+
+    for (i = 0; i < HPC_NUM; i++) {
+        if (sbi_hpc_read(i + 3, &now[i])) {
+            return;
+        }
+    }
+
+    if (!last_valid) {
+        memcpy(last_snapshot, now, sizeof(now));
+        last_valid = 1;
+        return;
+    }
+
+    for (i = 0; i < HPC_NUM; i++) {
+        if (now[i] < last_snapshot[i]) {
+            /* Overflow or reset: resync without attributing */
+            memcpy(last_snapshot, now, sizeof(now));
+            return;
+        }
+        delta[i] = now[i] - last_snapshot[i];
+        accum_global[i] += delta[i];
+    }
+
+    if (pid_filter != -1 && prev->pid == pid_filter) {
+        for (i = 0; i < HPC_NUM; i++)
+            accum_pid[i] += delta[i];
+
+        show_hpc(accum_pid,    HPC_NUM, prev->pid, 0);
+        show_hpc(accum_global, HPC_NUM, prev->pid, 1);
+    }
+
+    memcpy(last_snapshot, now, sizeof(now));
+}
+
+void show_hpc(const unsigned long *hpc_values, int count, int current_pid, int status)
+{
+    /* status: 0 = filtered PID, 1 = global */
+    char buffer[HPC_LOG_LINE_MAX];
+    int len = 0;
+    int i;
+
+    if (status == 0)
+        len += scnprintf(buffer + len, sizeof(buffer) - len, "FILTER PID %d", current_pid);
+    else
+        len += scnprintf(buffer + len, sizeof(buffer) - len, "GLOBAL PID %d", current_pid);
+
+    for (i = 0; i < count; i++)
+        len += scnprintf(buffer + len, sizeof(buffer) - len, " 0x%lX", hpc_values[i]);
+
+    if (len < sizeof(buffer) - 1)
+        buffer[len++] = '\n';
+
+    /* Line is dropped if the FIFO is full */
+    if (hpc_log_push(buffer, len) != len)
+        pr_info_ratelimited("hpc: log fifo full (drop line)\n");
+}
+
+static int __init hpc_monitor_init(void)
+{
+    hpc_log_debugfs_init();
+    return 0;
+}
+
+static void __exit hpc_monitor_exit(void)
+{
+    hpc_log_debugfs_exit();
+}
+
+module_init(hpc_monitor_init);
+module_exit(hpc_monitor_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("HPC filtering with debugfs logging");
