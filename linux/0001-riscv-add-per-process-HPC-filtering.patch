diff --git a/kernel/hpc/syscall_hpc.c b/kernel/hpc/syscall_hpc.c
new file mode 100644
index 000000000..c788e36ac
--- /dev/null
+++ b/kernel/hpc/syscall_hpc.c
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2025 Adam Henault <contact@adamhlt.com>
+ * Copyright (C) 2025 Lab-STICC
+ */
+
+#include <linux/kernel.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+
+#include "sbi_hpc.h"
+#include "hpc_filtering.h"
+
+SYSCALL_DEFINE2(hpc_config, unsigned long, hpm, unsigned long, event)
+{
+    return sbi_hpc_config(hpm, event);
+}
+
+SYSCALL_DEFINE2(hpc_read, unsigned long, hpm, unsigned long __user *, val)
+{
+    unsigned long kernel_val;
+    int ret = sbi_hpc_read(hpm, &kernel_val);
+    if (ret)
+        return ret;
+    if (copy_to_user(val, &kernel_val, sizeof(unsigned long)))
+        return -EFAULT;
+    return 0;
+}
+
+SYSCALL_DEFINE1(hpc_inhibit, unsigned long, hpm)
+{
+    return sbi_hpc_inhibit(hpm);
+}
+
+SYSCALL_DEFINE1(hpc_enable, unsigned long, hpm)
+{
+    return sbi_hpc_enable(hpm);
+}
+
+SYSCALL_DEFINE1(hpc_reset, unsigned long, hpm)
+{
+    return sbi_hpc_reset(hpm);
+}
+
+SYSCALL_DEFINE0(hpc_start)
