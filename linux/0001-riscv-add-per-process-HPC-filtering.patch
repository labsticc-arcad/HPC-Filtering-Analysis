+// Configure un HPM pour un event
+SYSCALL_DEFINE2(hpc_config, unsigned long, hpm, unsigned long, event)
+{
+    return sbi_hpc_config(hpm, event);
+}
+
+// Lit un HPM et retourne la valeur
+SYSCALL_DEFINE2(hpc_read, unsigned long, hpm, unsigned long __user *, val)
+{
+    unsigned long kernel_val;
+    int ret = sbi_hpc_read(hpm, &kernel_val);
+    if (ret)
+        return ret;
+    if (copy_to_user(val, &kernel_val, sizeof(unsigned long)))
+        return -EFAULT;
+    return 0;
+}
+
+// Inhibe un HPM
+SYSCALL_DEFINE1(hpc_inhibit, unsigned long, hpm)
+{
+    return sbi_hpc_inhibit(hpm);
+}
+
