diff --git a/arch/riscv/kernel/entry.S b/arch/riscv/kernel/entry.S
index 524d918f3..a69204707 100644
--- a/arch/riscv/kernel/entry.S
+++ b/arch/riscv/kernel/entry.S
@@ -97,6 +97,29 @@ _save_context:
 	la gp, __global_pointer$
 .option pop
 
+	# Stop HPCs on trap entry from U-mode
+    csrr    t2, sstatus
+    andi    t2, t2, (1 << 8)          # SPP: 0 = from U-mode
+    bnez    t2, 9f
+
+	mv      t4, a0
+    mv      t5, a1
+    mv      t6, a6
+    mv      t3, a7
+
+    li      a7, 0x0B000000            # SBI EID: HPC CSR interface
+    li      a6, 6                     # FID: STOP_HPC
+    mv      a0, zero
+    mv      a1, zero
+    ecall
+
+	mv      a0, t4
+    mv      a1, t5
+    mv      a6, t6
+    mv      a7, t3
+
+9:
+
 #ifdef CONFIG_TRACE_IRQFLAGS
 	call trace_hardirqs_off
 #endif
@@ -131,6 +154,7 @@ skip_context_tracking:
 	 * Exceptions run with interrupts enabled or disabled depending on the
 	 * state of SR_PIE in m/sstatus.
 	 */
+
 	andi t0, s1, SR_PIE
 	beqz t0, 1f
 	csrs CSR_STATUS, SR_IE
@@ -218,6 +242,7 @@ ret_from_syscall_rejected:
 
 ret_from_exception:
 	REG_L s0, PT_STATUS(sp)
+
 	csrc CSR_STATUS, SR_IE
 #ifdef CONFIG_TRACE_IRQFLAGS
 	call trace_hardirqs_off
@@ -252,6 +277,30 @@ resume_userspace:
 	csrw CSR_SCRATCH, tp
 
 restore_all:
+
+	# Restart HPCs on return to U-mode
+    csrr    t2, sstatus
+    andi    t2, t2, (1 << 8)          # SPP: 0 = from U-mode
+    bnez    t2, 9f
+
+	mv      t4, a0
+    mv      t5, a1
+    mv      t6, a6
+    mv      t3, a7
+
+    li      a7, 0x0B000000            # SBI EID: HPC CSR interface
+    li      a6, 5                     # FID: START_HPC
+    mv      a0, zero
+    mv      a1, zero
+    ecall
+
+	mv      a0, t4
+    mv      a1, t5
+    mv      a6, t6
+    mv      a7, t3
+
+9:
+
 #ifdef CONFIG_TRACE_IRQFLAGS
 	REG_L s1, PT_STATUS(sp)
 	andi t0, s1, SR_PIE
@@ -398,6 +447,7 @@ ENDPROC(ret_from_kernel_thread)
  */
 ENTRY(__switch_to)
 	/* Save context into prev->thread */
+
 	li    a4,  TASK_THREAD_RA
 	add   a3, a0, a4
 	add   a4, a1, a4
