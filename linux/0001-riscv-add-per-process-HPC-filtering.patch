+
+#ifndef _FILTERING_HPC_H
+#define _FILTERING_HPC_H
+
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/preempt.h>
+#include <linux/irqflags.h>
+#include <linux/sched.h>
+
+#include "sbi_hpc.h"
+
+/*
+ * Nous suivons HPM3..HPM(3+HPC_NUM-1).
+ * Adapte HPC_NUM à ton implémentation (ici 6).
+ */
+#define HPC_NUM 6
+
+/* API syscalls */
+int toogle_filtering(void);      /* on/off global (orthographe conservée) */
+void set_pid_filter(int pid);    /* choisir le PID à suivre, -1 = aucun */
+
+/* Appelée une fois par basculement de tâche dans le scheduler */
+void hpc_account_switch(struct task_struct *prev);
+
+/* Utilitaire d'affichage (debug) */
+void show_hpc(const unsigned long *hpc_values, int count, int current_pid, int status);
+
+#endif /* _FILTERING_HPC_H */
diff --git a/kernel/hpc/sbi_hpc.c b/kernel/hpc/sbi_hpc.c
