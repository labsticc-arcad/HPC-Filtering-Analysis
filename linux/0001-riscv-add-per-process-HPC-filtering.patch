+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2025 Adam Henault <contact@adamhlt.com>
+ * Copyright (C) 2025 Lab-STICC
+ */
+
+#include <linux/errno.h>
+#include "sbi_hpc.h"
+
+int sbi_hpc_config(unsigned long hpm, unsigned long event)
+{
+	struct sbiret ret;
+	ret = sbi_ecall(SBI_EXT_CSR_INTERFACE, SBI_CSR_CONFIG_HPM,
+	                hpm, event, 0, 0, 0, 0);
+	return ret.error;
+}
+
+int sbi_hpc_read(unsigned long hpm, unsigned long *val)
+{
+	struct sbiret ret;
+	ret = sbi_ecall(SBI_EXT_CSR_INTERFACE, SBI_CSR_READ_HPC,
+	                hpm, 0, 0, 0, 0, 0);
+	if (ret.error)
+		return ret.error;
+	if (val)
+		*val = ret.value;
+	return 0;
+}
+
+int sbi_hpc_inhibit(unsigned long hpm)
+{
+	struct sbiret ret;
+	ret = sbi_ecall(SBI_EXT_CSR_INTERFACE, SBI_CSR_INHIBIT_HPC,
+	                hpm, 0, 0, 0, 0, 0);
+	return ret.error;
+}
+
+int sbi_hpc_enable(unsigned long hpm)
+{
+	struct sbiret ret;
+	ret = sbi_ecall(SBI_EXT_CSR_INTERFACE, SBI_CSR_ENABLE_HPC,
+	                hpm, 0, 0, 0, 0, 0);
+	return ret.error;
+}
+
+int sbi_hpc_reset(unsigned long hpm)
+{
+	struct sbiret ret;
+	ret = sbi_ecall(SBI_EXT_CSR_INTERFACE, SBI_CSR_RESET_HPC,
+	                hpm, 0, 0, 0, 0, 0);
+	return ret.error;
+}
+
+int sbi_hpc_start(void)
+{
+	struct sbiret ret = sbi_ecall(SBI_EXT_CSR_INTERFACE, SBI_CSR_START_HPC,
+	                               0, 0, 0, 0, 0, 0);
+	return ret.error;
+}
+
+int sbi_hpc_stop(void)
+{
+	struct sbiret ret = sbi_ecall(SBI_EXT_CSR_INTERFACE, SBI_CSR_STOP_HPC,
+	                               0, 0, 0, 0, 0, 0);
+	return ret.error;
+}
+
+int sbi_hpc_toggle_debug(void)
+{
+	struct sbiret ret = sbi_ecall(SBI_EXT_CSR_INTERFACE, SBI_CSR_SHOW_DEBUG,
+	                               0, 0, 0, 0, 0, 0);
+	return ret.error;
+}
